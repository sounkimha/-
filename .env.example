# 이 파일을 .env 로 복사해서 채우세요:  cp .env.example .env
# .env 는 .gitignore 에 들어 있어 커밋되지 않습니다. 실제 값은 절대 커밋하지 마세요.

# 한국투자증권 Open API — '모의투자'용 앱키/시크릿 (apiportal.koreainvestment.com 에서 모의투자로 신청)
KIS_APP_KEY=
KIS_APP_SECRET=

# 모의투자 계좌번호: 앞 8자리 / 뒤 2자리(상품코드, 종합계좌는 01)
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=01

# true(기본) 이면 주문을 절대 전송하지 않고 로그·가상계좌에만 기록합니다.
# 모의투자 서버로 실제 주문을 보내려면 직접 false 로 바꾸세요. (실전 서버는 코드에서 거부)
DRY_RUN=true
